<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" modified="2026-06-05T08:15:00Z" agent="5.0" version="22.1.2" type="device"><diagram id="fingerprint_pipeline_detailed_hld_lld" name="Fingerprint Pipeline Detailed HLD LLD"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="6100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg_container" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0a0a0f;strokeColor=none;opacity=100;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1960" height="6000" as="geometry" /></mxCell><mxCell id="title_block" value="&lt;b&gt;&lt;font size='6' color='#e8e8f0'&gt;Fingerprint Biometric Verification Pipeline&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;b&gt;&lt;font size='4' color='#a78bfa'&gt;Detailed High-Level Design (HLD) &amp;amp; Low-Level Design (LLD) Flow Map&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color='#8888aa' size='2'&gt;A complete engineering blueprint mapping all 12 Python files in &lt;b&gt;src/&lt;/b&gt;, key data representations, functions, layers, metrics, and parameters.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="1200" height="100" as="geometry" /></mxCell><mxCell id="hld_0" value="&lt;b&gt;&lt;font size='4' color='#7c6af7'&gt;Stage 1: Config Dataclasses&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p01_config.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Global configuration storage using frozen Python dataclasses. Encapsulates dataset directories, neural network layer dimensions, training hyperparameters, and experimental sweeps. Serves as the single source of truth for the entire pipeline to guarantee type-safety and determinism.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#7c6af7;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_0" value="&lt;b&gt;&lt;font color='#7c6af7' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Defines five distinct frozen configuration schemas to guarantee end-to-end type safety, static attributes, and deterministic random seeds.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_0" target="lld_0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_0_0" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;⚙️ SplitConfig&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Specifies dataset partition ratios and randomization seed:&lt;br/&gt;• train_ratio: float = 0.70&lt;br/&gt;• validation_ratio: float = 0.15&lt;br/&gt;• test_ratio: float = 0.15&lt;br/&gt;• seed: int = 42&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_0"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_0_1" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📐 RuntimeConfig&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Specifies hardware parameters and tensor dimensions:&lt;br/&gt;• image_width: int = 96&lt;br/&gt;• image_height: int = 103&lt;br/&gt;• embedding_dim: int = 128&lt;br/&gt;• batch_size: int = 48&lt;br/&gt;• eval_batch_size: int = 96&lt;br/&gt;• num_workers: int = 2&lt;br/&gt;• device: str = &amp;#x27;cuda&amp;#x27; / &amp;#x27;cpu&amp;#x27;&lt;br/&gt;• pin_memory: bool = True (if cuda)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_0"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_0_2" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📝 TrainingConfig&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Specifies training and optimization hyperparameters:&lt;br/&gt;• baseline_epochs: int = 2&lt;br/&gt;• search_epochs: int = 2&lt;br/&gt;• final_epochs: int = 2&lt;br/&gt;• samples_per_identity: int = 4&lt;br/&gt;• train_steps_per_epoch: int = 120&lt;br/&gt;• search_steps_per_epoch: int = 60&lt;br/&gt;• learning_rates: tuple = (1e-3, 3e-4)&lt;br/&gt;• batch_sizes: tuple = (32, 48)&lt;br/&gt;• margins: tuple = (0.75, 1.0)&lt;br/&gt;• weight_decay: float = 1e-4&lt;br/&gt;• early_stopping_patience: int = 2&lt;br/&gt;• max_impostor_pairs_per_identity: int = 128&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_0"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_0_3" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;🔀 ExperimentGrid&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Specifies configuration sweeps for grids:&lt;br/&gt;• preprocess_variants: tuple = (&amp;#x27;raw&amp;#x27;, &amp;#x27;segmented&amp;#x27;, &amp;#x27;normalized&amp;#x27;, &amp;#x27;gabor&amp;#x27;, &amp;#x27;skeleton&amp;#x27;)&lt;br/&gt;• augmentation_variants: tuple = (&amp;#x27;none&amp;#x27;, &amp;#x27;rotate&amp;#x27;, &amp;#x27;elastic&amp;#x27;, &amp;#x27;obliterate&amp;#x27;, &amp;#x27;combined&amp;#x27;)&lt;br/&gt;• model_variants: tuple = (&amp;#x27;compact_siamese&amp;#x27;, &amp;#x27;mobile_triplet&amp;#x27;)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_0"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_0_4" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📂 AppConfig &amp;amp; Loader&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Aggregates nested configs:&lt;br/&gt;• project_root: Path&lt;br/&gt;• dataset_root: Path = project_root/archive/SOCOFing&lt;br/&gt;• output_root: Path = project_root/artifacts&lt;br/&gt;• split: SplitConfig&lt;br/&gt;• runtime: RuntimeConfig&lt;br/&gt;• training: TrainingConfig&lt;br/&gt;• grid: ExperimentGrid&lt;br/&gt;• Resolves relative paths dynamically via: AppConfig.from_root(project_root)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_0"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_1" value="&lt;b&gt;&lt;font size='4' color='#a78bfa'&gt;Stage 2: BMP Decoder&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p02_bmp_reader.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Custom low-level BMP image reader implementing binary struct parsing. Bypasses external image processing libraries (like PIL or OpenCV) to operate purely on standard library primitives and numpy. Decodes 8-bit paletted, 24-bit RGB, and 32-bit BGRA images directly into normalized float32 grayscale tensors.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#a78bfa;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_1" value="&lt;b&gt;&lt;font color='#a78bfa' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Decodes binary headers and pixel streams, handling row strides, color mapping tables, NTSC transformations, and vertical orientation corrections.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_1" target="lld_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_1_0" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🔍 Header Parser&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Unpacks BMP header bytes:&lt;br/&gt;• Magic bytes: checks if starts with b&amp;#x27;BM&amp;#x27;&lt;br/&gt;• Offset 10: pixel_offset (I)&lt;br/&gt;• Offset 14: DIB size (I)&lt;br/&gt;• Offset 18: width (i), height (i), planes (H), bits_per_pixel (H), compression (I)&lt;br/&gt;• Validates planes == 1&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_1"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_1_1" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;📐 Row Stride Calc&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Handles 4-byte padding alignment:&lt;br/&gt;• Formula: ((width * bpp + 31) // 32) * 4&lt;br/&gt;• Prevents pixel misalignment during buffer reads.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_1"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_1_2" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🎨 8-bit Paletted Decoder&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Decodes 8-bit color indexed images:&lt;br/&gt;• Extracts palette at (14 + DIB size)&lt;br/&gt;• Computes grayscale palette: palette[:, :3].mean(axis=1)&lt;br/&gt;• Reads pixel index matrix of size (height, stride) via np.frombuffer&lt;br/&gt;• Maps indices to grayscale colors&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_1"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_1_3" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🖼️ Direct Decoder&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Decodes color pixel matrices:&lt;br/&gt;• 24-bit: reads RGB, applies NTSC: 0.299*R + 0.587*G + 0.114*B&lt;br/&gt;• 32-bit: unpacks channel bitmasks from header (default BGRA), extracts channels via _mask_to_channel(), scales by alpha: grayscale = NTSC * alpha&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_1"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_1_4" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🔢 load_socofing_bmp&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Entry point returning PyTorch Tensor:&lt;br/&gt;• Loads file bytes&lt;br/&gt;• Decodes via bits_per_pixel (8, 24, 32)&lt;br/&gt;• Flips image vertically if height &amp;gt; 0 (via np.flipud) since BMPs are stored bottom-up&lt;br/&gt;• Scales output to [0.0, 1.0] shape (1, H, W) float32&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_1"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_2" value="&lt;b&gt;&lt;font size='4' color='#34d399'&gt;Stage 3: Indexing &amp;amp; Parsing&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p03_dataset_index.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Iterates through the raw dataset folders, parses filenames using tokenization to extract metadata fields, and catalogs all available fingerprint prints into a structured manifest of records. Handles both case-insensitive directory names and varied filename structures.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#34d399;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="1200" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_2" value="&lt;b&gt;&lt;font color='#34d399' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Parses filenames into FingerprintRecord objects, walks raw directories, and handles Real and Altered splits.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="1140" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_2" target="lld_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_2_0" value="&lt;b&gt;&lt;font size='2' color='#34d399'&gt;🏷️ FingerprintRecord&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Dataclass representing one file:&lt;br/&gt;• path: Path&lt;br/&gt;• subject_id: int&lt;br/&gt;• gender: str (&amp;#x27;M&amp;#x27;/&amp;#x27;F&amp;#x27;)&lt;br/&gt;• hand: str (&amp;#x27;Left&amp;#x27;/&amp;#x27;Right&amp;#x27;)&lt;br/&gt;• finger: str (thumb/index/middle/ring/little)&lt;br/&gt;• source: str (real/altered)&lt;br/&gt;• difficulty: str (Real/Easy/Med/Hard)&lt;br/&gt;• alteration: str (e.g. CR, Z, W, REAL)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_2"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_2_1" value="&lt;b&gt;&lt;font size='2' color='#34d399'&gt;🔑 Identity Key&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Returns unique identifier:&lt;br/&gt;• f&amp;#x27;{subject_id:03d}__{gender}_{hand}_{finger}_finger&amp;#x27;&lt;br/&gt;• Uniquely groups all variations (real, altered, augmentations) of a single finger.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_2"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_2_2" value="&lt;b&gt;&lt;font size='2' color='#34d399'&gt;⚙️ Filename Parser&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Extracts metadata from filename:&lt;br/&gt;• Splits filename stem by &amp;#x27;__&amp;#x27; to get subject ID&lt;br/&gt;• Splits remainder by &amp;#x27;_&amp;#x27; to extract gender, hand, finger&lt;br/&gt;• Checks for alteration label at index 4 (defaults to REAL)&lt;br/&gt;• Source is &amp;#x27;altered&amp;#x27; if &amp;#x27;altered&amp;#x27; is in path parts&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_2"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_2_3" value="&lt;b&gt;&lt;font size='2' color='#34d399'&gt;📂 Dataset Indexer&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Walks root directory:&lt;br/&gt;• Case-insensitively locates &amp;#x27;Real&amp;#x27; and &amp;#x27;Altered&amp;#x27; subfolders&lt;br/&gt;• Gathers paths using glob: *.BMP, *.bmp, *.Bmp, *.BMP*&lt;br/&gt;• Parses files via parse_record()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_2"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_2_4" value="&lt;b&gt;&lt;font size='2' color='#34d399'&gt;📋 Index Validation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Assembles and validates lists:&lt;br/&gt;• Combines real and altered list[FingerprintRecord]&lt;br/&gt;• Ensures data is sorted and paths are unique&lt;br/&gt;• Raises FileNotFoundError if no BMP files are found&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_2"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_3" value="&lt;b&gt;&lt;font size='4' color='#fbbf24'&gt;Stage 4: Identity-Disjoint Split&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p04_phase_one_split.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Partitions the indexed dataset into Train (70%), Validation (15%), and Test (15%) subsets. Splitting is executed strictly at the subject identity level to prevent data leakage (ensuring that a subject&amp;#x27;s real scan and all their altered variants are grouped in the same partition).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#fbbf24;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="1680" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_3" value="&lt;b&gt;&lt;font color='#fbbf24' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Groups files by identity, shuffles keys, assigns splits, saves manifests, and provides custom PyTorch Datasets/Samplers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="1620" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_3" target="lld_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_3_0" value="&lt;b&gt;&lt;font size='2' color='#fbbf24'&gt;🔀 Disjoint Splitter&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Splits identity keys disjointly:&lt;br/&gt;• Groups records by identity_key&lt;br/&gt;• Shuffles keys with np.random.default_rng(seed).permutation()&lt;br/&gt;• Splits keys at 70% and 85%&lt;br/&gt;• Maps all associated records into Train/Val/Test subsets&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_3"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_3_1" value="&lt;b&gt;&lt;font size='2' color='#fbbf24'&gt;🚫 Leakage Policy&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Guarantees zero leakage across partitions:&lt;br/&gt;• All altered versions (Easy/Medium/Hard) of a subject are grouped in the same split as the real scan.&lt;br/&gt;• Evaluates models on completely unseen fingers.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_3"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_3_2" value="&lt;b&gt;&lt;font size='2' color='#fbbf24'&gt;📄 Manifest CSV&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Serializes the split results to &amp;#x27;identity_split.csv&amp;#x27;:&lt;br/&gt;• Columns: split, identity_key, file_name, source, difficulty, alteration&lt;br/&gt;• Enables visual inspection and exact reproduction of splits.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_3"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_3_3" value="&lt;b&gt;&lt;font size='2' color='#fbbf24'&gt;⚖️ FingerprintDataset&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;PyTorch Dataset implementation:&lt;br/&gt;• __getitem__(index) loads image via load_socofing_bmp()&lt;br/&gt;• Resizes image using F.interpolate in bilinear mode if it differs from target_size&lt;br/&gt;• Returns (image_tensor, label_int, dataset_index)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_3"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_3_4" value="&lt;b&gt;&lt;font size='2' color='#fbbf24'&gt;⚡ IdentityBatchSampler&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Ensures balanced batches during training:&lt;br/&gt;• Groups indices by identity_key&lt;br/&gt;• Draws B/4 identity keys per step&lt;br/&gt;• Samples 4 indices per identity (sampling with replacement if needed)&lt;br/&gt;• Guarantees positive pairs in every batch for metric learning&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_3"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_4" value="&lt;b&gt;&lt;font size='4' color='#60a5fa'&gt;Stage 5: Preprocessing&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p05_phase_two_preprocessing.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Enhances fingerprint ridge clarity and filters background noise. Computes 5 distinct preprocessed variants: raw (original), segmented (background mask applied), normalized (adaptive contrast adjustment), gabor (directional Gabor filtering), and skeleton (single-pixel ridge thinning).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#60a5fa;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="2160" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_4" value="&lt;b&gt;&lt;font color='#60a5fa' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Applies mathematical computer vision algorithms using PyTorch operations to process batch image tensors.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="2100" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_4" target="lld_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_4_0" value="&lt;b&gt;&lt;font size='2' color='#60a5fa'&gt;✂️ Block Segmentation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Extracts foreground mask:&lt;br/&gt;• Divides image into 8x8 blocks&lt;br/&gt;• Computes block mean and variance via F.avg_pool2d&lt;br/&gt;• Thresholds: variance &amp;gt; mean_variance * 0.35&lt;br/&gt;• Interpolates to original size, applies 5x5 smoothing filter, thresholds at 0.2&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_4"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_4_1" value="&lt;b&gt;&lt;font size='2' color='#60a5fa'&gt;📐 Intensity Normalization&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Equalizes foreground ridge contrast:&lt;br/&gt;• Computes mean and variance of pixels under mask&lt;br/&gt;• Normalizes: (pixel - mean) / sqrt(variance)&lt;br/&gt;• Scales: normalized * target_std (0.22) + target_mean (0.5)&lt;br/&gt;• Zeroes out background pixels outside mask&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_4"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_4_2" value="&lt;b&gt;&lt;font size='2' color='#60a5fa'&gt;🌀 Ridge Orientation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Estimates local ridge angles:&lt;br/&gt;• Convolves image with Sobel-X and Sobel-Y filters&lt;br/&gt;• Computes local covariances (grad_xx, grad_yy, grad_xy) using 9x9 average pool&lt;br/&gt;• Computes angle: 0.5 * atan2(2*grad_xy, grad_xx - grad_yy + 1e-6) + pi&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_4"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_4_3" value="&lt;b&gt;&lt;font size='2' color='#60a5fa'&gt;🌿 Gabor Filter Bank&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Applies 6 directional Gabor kernels:&lt;br/&gt;• Bank (angles 0 to pi, step pi/7) cached via @lru_cache&lt;br/&gt;• Convolves image with all 6 kernels via conv2d&lt;br/&gt;• For each pixel, gathers response of filter closest to local ridge angle&lt;br/&gt;• Normalizes output and applies sigmoid&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_4"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_4_4" value="&lt;b&gt;&lt;font size='2' color='#60a5fa'&gt;🦴 Zhang-Suen Thinning&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Reduces ridges to 1-pixel skeletons:&lt;br/&gt;• Binarizes via F.avg_pool2d local mean&lt;br/&gt;• Runs Zhang-Suen algorithm in numpy&lt;br/&gt;• Iteratively prunes pixels checking 8-neighbors (degree 2 to 6, transition count == 1, sub-pass masks)&lt;br/&gt;• Converts back to tensor&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_4"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_5" value="&lt;b&gt;&lt;font size='4' color='#fb923c'&gt;Stage 6: Data Augmentation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p06_phase_three_augmentation.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Applies stochastic spatial deformations, rotations, and structural obliterators to input images. Augmentation prevents model overfitting, makes features invariant to print rotation, and simulates real-world noise (such as scars, smudge, or poor contact).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#fb923c;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="2640" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_5" value="&lt;b&gt;&lt;font color='#fb923c' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Implements geometric and occlusion transforms on-the-fly using PyTorch grid sampling and random coordinate masking.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="2580" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_5" target="lld_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_5_0" value="&lt;b&gt;&lt;font size='2' color='#fb923c'&gt;🔄 Grid Generator&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Creates baseline coordinate grids:&lt;br/&gt;• Generates normalized coordinates in [-1.0, 1.0]&lt;br/&gt;• Shapes grid tensor to (batch, height, width, 2) using torch.linspace and meshgrid&lt;br/&gt;• Serves as spatial template for coordinate warping&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_5"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_5_1" value="&lt;b&gt;&lt;font size='2' color='#fb923c'&gt;📐 Affine Rotation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Stochastic image rotation:&lt;br/&gt;• Samples batch of angles uniformly in [-45, 45] degrees&lt;br/&gt;• Builds 2x3 transformation matrices containing cos and sin values&lt;br/&gt;• Generates grids using F.affine_grid&lt;br/&gt;• Samples pixels via F.grid_sample in bilinear mode&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_5"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_5_2" value="&lt;b&gt;&lt;font size='2' color='#fb923c'&gt;🌊 Elastic Distortion&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Simulates skin elasticity:&lt;br/&gt;• Generates low-res (8x8) random displacement vectors&lt;br/&gt;• Interpolates to image size using bicubic mode&lt;br/&gt;• Smoothes displacements with 5x5 average pooling&lt;br/&gt;• Warps base grid: grid + displacement&lt;br/&gt;• Resamples image via F.grid_sample&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_5"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_5_3" value="&lt;b&gt;&lt;font size='2' color='#fb923c'&gt;⬛ Obliteration&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Simulates scars or occlusion:&lt;br/&gt;• Computes random patch size (10% to 22% of short side)&lt;br/&gt;• Samples random starting coordinates (x_start, y_start)&lt;br/&gt;• Overlays zeroed (black) square mask on-the-fly&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_5"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_5_4" value="&lt;b&gt;&lt;font size='2' color='#fb923c'&gt;🔀 Dispatcher&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Routes the augmentation request:&lt;br/&gt;• &amp;#x27;none&amp;#x27;: returns original image&lt;br/&gt;• &amp;#x27;rotate&amp;#x27;, &amp;#x27;elastic&amp;#x27;, &amp;#x27;obliterate&amp;#x27;: returns single transform&lt;br/&gt;• &amp;#x27;combined&amp;#x27;: chains rotation -&amp;gt; elastic distortion -&amp;gt; obliteration&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_5"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_6" value="&lt;b&gt;&lt;font size='4' color='#f87171'&gt;Stage 7: Model Architectures&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p07_phase_four_models.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Defines deep neural network encoders that map a 103x96 input image to a normalized 128-dimensional latent embedding. Projects features onto a hypersphere so that L2 Euclidean distances correspond directly to biometric similarity.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#f87171;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="3120" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_6" value="&lt;b&gt;&lt;font color='#f87171' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Defines sub-layers and compares a compact standard CNN (compact_siamese) with a parameter-efficient depthwise separable CNN (mobile_triplet).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="3060" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_6" target="lld_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_6_0" value="&lt;b&gt;&lt;font size='2' color='#f87171'&gt;🌐 L2Normalize Layer&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Normalizes features to unit L2 length:&lt;br/&gt;• Class L2Normalize(nn.Module)&lt;br/&gt;• forward(x) computes: x / ||x||_2 via F.normalize(dim=1)&lt;br/&gt;• Projects embeddings onto a 128-D hypersphere surface to stabilize metric learning&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_6"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_6_1" value="&lt;b&gt;&lt;font size='2' color='#f87171'&gt;⚡ Depthwise Separable Conv&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Implements MobileNet-style block:&lt;br/&gt;• 3x3 depthwise conv (groups=in_channels, bias=False)&lt;br/&gt;• BatchNorm2d + GELU activation&lt;br/&gt;• 1x1 pointwise conv (out_channels, bias=False)&lt;br/&gt;• BatchNorm2d + GELU activation&lt;br/&gt;• Reduces parameters 3x to 4x&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_6"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_6_2" value="&lt;b&gt;&lt;font size='2' color='#f87171'&gt;🧠 compact_siamese Encoder&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Standard CNN (118K parameters):&lt;br/&gt;• Conv2d(1 -&amp;gt; 24), BN, GELU, MaxPool2d(2)&lt;br/&gt;• Conv2d(24 -&amp;gt; 48), BN, GELU, MaxPool2d(2)&lt;br/&gt;• Conv2d(48 -&amp;gt; 72), BN, GELU, MaxPool2d(2)&lt;br/&gt;• Conv2d(72 -&amp;gt; 96), BN, GELU&lt;br/&gt;• AdaptiveAvgPool2d(1) -&amp;gt; Flatten&lt;br/&gt;• Linear(96 -&amp;gt; 128) -&amp;gt; L2Normalize&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_6"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_6_3" value="&lt;b&gt;&lt;font size='2' color='#f87171'&gt;📱 mobile_triplet Encoder&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Lightweight CNN (31K parameters):&lt;br/&gt;• Conv2d(1 -&amp;gt; 16), BN, GELU&lt;br/&gt;• DepthwiseSeparableBlock(16 -&amp;gt; 24, stride=2)&lt;br/&gt;• DepthwiseSeparableBlock(24 -&amp;gt; 48, stride=2)&lt;br/&gt;• DepthwiseSeparableBlock(48 -&amp;gt; 72, stride=2)&lt;br/&gt;• DepthwiseSeparableBlock(72 -&amp;gt; 96, stride=1)&lt;br/&gt;• AdaptiveAvgPool2d(1) -&amp;gt; Flatten&lt;br/&gt;• Linear(96 -&amp;gt; 128) -&amp;gt; L2Normalize&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_6"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_6_4" value="&lt;b&gt;&lt;font size='2' color='#f87171'&gt;⚙️ create_model Factory&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Instantiates network &amp;amp; loss name:&lt;br/&gt;• &amp;#x27;compact_siamese&amp;#x27;: returns compact encoder and &amp;#x27;contrastive&amp;#x27; loss config&lt;br/&gt;• &amp;#x27;mobile_triplet&amp;#x27;: returns mobile encoder and &amp;#x27;triplet&amp;#x27; loss config&lt;br/&gt;• Validates input names&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_6"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_7" value="&lt;b&gt;&lt;font size='4' color='#22d3ee'&gt;Stage 8: Metric Learning Loss&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p08_metric_learning.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Calculates distance metrics in the 128-D embedding space. Updates network parameters by minimizing objective functions that pull matching fingers together and push non-matching fingers apart.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#22d3ee;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="3600" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_7" value="&lt;b&gt;&lt;font color='#22d3ee' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Computes pairwise Euclidean matrices and calculates Contrastive Loss (with hard negative mining) and Batch-Hard Triplet Loss.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="3540" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_7" target="lld_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_7_0" value="&lt;b&gt;&lt;font size='2' color='#22d3ee'&gt;📏 Pairwise L2 Matrix&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Computes all-to-all Euclidean distances:&lt;br/&gt;• Inputs embeddings tensor of shape (N, 128)&lt;br/&gt;• Output matrix shape is (N, N) using torch.cdist(p=2)&lt;br/&gt;• Distance formula: d(x, y) = ||x - y||_2&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_7"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_7_1" value="&lt;b&gt;&lt;font size='2' color='#22d3ee'&gt;🔗 Contrastive Batch Loss&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Computes pairwise contrastive loss:&lt;br/&gt;• Extracts positive/negative pairs via upper-triangular masks&lt;br/&gt;• Positive loss = positive_distances.square().mean()&lt;br/&gt;• Extracts hard negatives: distances &amp;lt; margin&lt;br/&gt;• Negative loss = relu(margin - hard_negatives).square().mean()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_7"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_7_2" value="&lt;b&gt;&lt;font size='2' color='#22d3ee'&gt;🎯 Batch-Hard Triplet Loss&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Mines hardest samples in batch:&lt;br/&gt;• For each anchor in batch, extracts hardest positive distance (maximum same-class distance)&lt;br/&gt;• Extracts hardest negative distance (minimum diff-class distance)&lt;br/&gt;• Loss = relu(hardest_pos - hardest_neg + margin).mean()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_7"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_7_3" value="&lt;b&gt;&lt;font size='2' color='#22d3ee'&gt;📝 LossSummary Dataclass&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Holds metric learning diagnostic metrics:&lt;br/&gt;• loss: torch.Tensor (the scalar backward gradient source)&lt;br/&gt;• positive_distance: float (mean positive distance)&lt;br/&gt;• negative_distance: float (mean negative/hard-negative distance)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_7"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_7_4" value="&lt;b&gt;&lt;font size='2' color='#22d3ee'&gt;🔀 Loss Dispatcher&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Routes calculations based on model choice:&lt;br/&gt;• Routes to contrastive_batch_loss(margin) for Siamese&lt;br/&gt;• Routes to batch_hard_triplet_loss(margin) for Triplet&lt;br/&gt;• Returns structured LossSummary&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_7"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_8" value="&lt;b&gt;&lt;font size='4' color='#f472b6'&gt;Stage 9: Training &amp;amp; Validation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p09_training.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Manages the training and validation epochs. Updates encoder model parameters, calculates validation EER and loss, handles early stopping to prevent overfitting, and saves the best model state checkpoints.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#f472b6;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="4080" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_8" value="&lt;b&gt;&lt;font color='#f472b6' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Integrates Mixed Precision (AMP), AdamW optimizer, gradient clipping, evaluation embedding harvesting, and early stopping.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="4020" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_8" target="lld_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_8_0" value="&lt;b&gt;&lt;font size='2' color='#f472b6'&gt;🔄 AMP Train Step&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Runs single training epoch:&lt;br/&gt;• Loops batches, applies augmentation&lt;br/&gt;• Uses torch.autocast(device_type=&amp;#x27;cuda&amp;#x27;, dtype=float16)&lt;br/&gt;• Computes forward pass and metric loss&lt;br/&gt;• unscale_() &amp;amp; clips gradients: norm &amp;lt;= 1.0&lt;br/&gt;• Backpropagates and steps optimizer via GradScaler&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_8"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_8_1" value="&lt;b&gt;&lt;font size='2' color='#f472b6'&gt;⚙️ Optimizer &amp;amp; Loader Setup&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Sets up optimization parameters:&lt;br/&gt;• Optimizer: AdamW (lr=3e-4 or 1e-3, weight_decay=1e-4)&lt;br/&gt;• Training loader uses balanced IdentityBatchSampler&lt;br/&gt;• Validation loader uses regular batching to compute validation loss&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_8"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_8_2" value="&lt;b&gt;&lt;font size='2' color='#f472b6'&gt;📥 Embedding Harvester&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Extracts embeddings for biometric evaluation:&lt;br/&gt;• Runs model in evaluation mode under torch.no_grad()&lt;br/&gt;• Collects batch outputs, maps indices back to records&lt;br/&gt;• Returns np.ndarray of shape (N, 128) and list[FingerprintRecord]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_8"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_8_3" value="&lt;b&gt;&lt;font size='2' color='#f472b6'&gt;🛑 Early Stopping &amp;amp; Save&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Monitors validation performance:&lt;br/&gt;• Computes validation EER after each epoch&lt;br/&gt;• If EER improves: best_epoch = epoch, saves state_dict to {experiment_id}.pt&lt;br/&gt;• If no improvement for patience=2 epochs, breaks loop early&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_8"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_8_4" value="&lt;b&gt;&lt;font size='2' color='#f472b6'&gt;💾 ExperimentResult&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Consolidates all run metrics:&lt;br/&gt;• experiment_id, hyperparams (lr, batch_size, margin)&lt;br/&gt;• history: list[EpochHistory] (loss, validation_eer, etc)&lt;br/&gt;• best_epoch, test_metrics, validation_metrics, checkpoint_path&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_8"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_9" value="&lt;b&gt;&lt;font size='4' color='#818cf8'&gt;Stage 10: Biometric Evaluation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p10_phase_five_evaluation.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Computes biometric verification performance (EER, FAR, FRR) by matching probe embeddings against enrolled master templates.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#818cf8;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="4560" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_9" value="&lt;b&gt;&lt;font color='#818cf8' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Extracts templates, computes L2 Euclidean distances, sweeps thresholds, and calculates FAR/FRR.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="4500" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_9" target="lld_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_9_0" value="&lt;b&gt;&lt;font size='2' color='#818cf8'&gt;🔐 Template Enrollment&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Enrolls master templates:&lt;br/&gt;• Groups test embeddings by identity key&lt;br/&gt;• For each identity, selects the first &amp;#x27;real&amp;#x27; print as master template. If no &amp;#x27;real&amp;#x27; print, falls back to first available print&lt;br/&gt;• Remaining prints serve as probes&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_9"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_9_1" value="&lt;b&gt;&lt;font size='2' color='#818cf8'&gt;✅ Genuine Match Scores&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Computes distances of matching fingers:&lt;br/&gt;• Computes L2 distance between master template and all remaining probes of the same finger&lt;br/&gt;• Genuine Score = ||template_id - probe_id||_2&lt;br/&gt;• Yields genuine distance score array&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_9"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_9_2" value="&lt;b&gt;&lt;font size='2' color='#818cf8'&gt;❌ Impostor Match Scores&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Computes distances of non-matching fingers:&lt;br/&gt;• For each enrolled master template, randomly selects other identity templates (up to max_impostor_pairs_per_identity)&lt;br/&gt;• Impostor Score = ||template_id - template_other||_2&lt;br/&gt;• Yields impostor distance score array&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_9"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_9_3" value="&lt;b&gt;&lt;font size='2' color='#818cf8'&gt;📈 FAR &amp;amp; FRR Sweeps&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Sweeps 512 thresholds from min to max:&lt;br/&gt;• Threshold range: [min(all_scores), max(all_scores)]&lt;br/&gt;• False Acceptance Rate: FAR = (impostor_scores &amp;lt;= threshold).mean()&lt;br/&gt;• False Rejection Rate: FRR = (genuine_scores &amp;gt; threshold).mean()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_9"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_9_4" value="&lt;b&gt;&lt;font size='2' color='#818cf8'&gt;🏆 EER &amp;amp; Accuracy Calculation&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Finds optimal biometric threshold:&lt;br/&gt;• Equal Error Rate: EER is threshold where |FAR - FRR| is minimized: (FAR + FRR) / 2.0&lt;br/&gt;• Accuracy: (correct_genuines + correct_impostors) / total&lt;br/&gt;• Returns VerificationMetrics dataclass&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_9"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_10" value="&lt;b&gt;&lt;font size='4' color='#7c6af7'&gt;Stage 11: Visualization Generator&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p11_visualization.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;Generates diagnostic visual artifacts for debugging and evaluation. Programmatically saves preprocessing strips, augmentation comparisons, and renders custom XML SVG files for training loss curves, ROC traces, and EER bar charts.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#7c6af7;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="5040" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_10" value="&lt;b&gt;&lt;font color='#7c6af7' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Converts PyTorch float tensors to uint8 PNGs, concatenates arrays, and programmatically generates raw XML SVG text.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="4980" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_10" target="lld_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_10_0" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;🖼️ PNG Exporter&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Writes image files:&lt;br/&gt;• Clamps float32 tensor to [0.0, 1.0]&lt;br/&gt;• Scales to 255.0, rounds, and casts to torch.uint8&lt;br/&gt;• Exposes single-channel grayscale array&lt;br/&gt;• Writes to file path via torchvision.io.write_png()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_10"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_10_1" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;🎞️ Strip Generator&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Stitches image stages horizontally:&lt;br/&gt;• Concatenates image list along the width dimension: torch.cat(images, dim=2)&lt;br/&gt;• Outputs &amp;#x27;preprocess_strip.png&amp;#x27; and &amp;#x27;augmentation_strip.png&amp;#x27; comparison charts&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_10"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_10_2" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📈 SVG Line Chart&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Draws vector line charts:&lt;br/&gt;• Computes X, Y viewport mappings for datasets&lt;br/&gt;• Generates SVG path polyline coordinates&lt;br/&gt;• Draws horizontal grid lines, scale labels, axis headers, and color-coded legends (e.g. for loss curves)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_10"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_10_3" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📊 SVG Bar Chart&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Draws vector bar charts:&lt;br/&gt;• Calculates bar widths and heights based on maximum data value&lt;br/&gt;• Renders rect elements with rounded corners (rx=6)&lt;br/&gt;• Writes data values above bars and rotates label texts -50 degrees&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_10"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_10_4" value="&lt;b&gt;&lt;font size='2' color='#7c6af7'&gt;📝 Visualizer Exporter&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Generates standard output files:&lt;br/&gt;• baseline_loss.svg: checks training/validation overfitting&lt;br/&gt;• best_roc.svg: plots True Positive Rate vs False Acceptance Rate&lt;br/&gt;• final_eer.svg: compares final test EER across preprocessing/models&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_10"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="hld_11" value="&lt;b&gt;&lt;font size='4' color='#a78bfa'&gt;Stage 12: Runner &amp;amp; Orchestration&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font size='2' color='#8888aa'&gt;File: p12_experiment_runner.py&lt;/font&gt;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='2' color='#e8e8f0'&gt;High-level driver script orchestrating the execution of the entire pipeline. Executes splits, coordinates baseline training, sweeps augmentation variants, searches hyperparameters, runs the final comparative grid, and exports a unified pipeline summary JSON file.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1e28;strokeColor=#a78bfa;strokeWidth=3.5;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingLeft=15;spacingRight=15;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="80" y="5520" width="380" height="240" as="geometry" /></mxCell><mxCell id="lld_11" value="&lt;b&gt;&lt;font color='#a78bfa' size='3'&gt;Low-Level Design (LLD)&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color='#8888aa' size='2'&gt;Implements run profiles, sequences the four core pipeline phases, and saves summaries and checkpoints.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111118;strokeColor=#2d2d3a;strokeWidth=2;fontColor=#e8e8f0;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" vertex="1" parent="1"><mxGeometry x="520" y="5460" width="1350" height="360" as="geometry" /></mxCell><mxCell id="conn_hl_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8888aa;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="hld_11" target="lld_11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="comp_11_0" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🏁 Profile Configurator&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Overrides configs based on runtime profile:&lt;br/&gt;• &amp;#x27;smoke&amp;#x27;: validation checks (1 epoch, 12 steps/epoch, mini batch, 32 impostor pairs)&lt;br/&gt;• &amp;#x27;balanced&amp;#x27;: default configuration&lt;br/&gt;• &amp;#x27;full&amp;#x27;: robust sweep (baseline_epochs=3, train_steps=180)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_11"><mxGeometry x="18" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_11_1" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;🔍 Phases A &amp;amp; B&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Baseline and Augmentation search:&lt;br/&gt;• Phase A: Trains baseline compact_siamese on raw images&lt;br/&gt;• Phase B: Sweeps all 5 augmentation variants using Gabor preprocessing to find the best augmentation variant&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_11"><mxGeometry x="286" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_11_2" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;⚙️ Phase C Hyperparameter Sweep&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Grid searches optimization parameters:&lt;br/&gt;• Sweeps learning rates (1e-3, 3e-4) x batch sizes (32, 48) x contrastive margins (0.75, 1.0) using best augmentation&lt;br/&gt;• Selects parameters minimizing validation EER&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_11"><mxGeometry x="554" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_11_3" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;📊 Phase D Final Grid&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Final comparative evaluation:&lt;br/&gt;• Trains 10 configurations: preprocess variants (&amp;#x27;raw&amp;#x27;, &amp;#x27;segmented&amp;#x27;, &amp;#x27;normalized&amp;#x27;, &amp;#x27;gabor&amp;#x27;, &amp;#x27;skeleton&amp;#x27;) x models (&amp;#x27;compact_siamese&amp;#x27;, &amp;#x27;mobile_triplet&amp;#x27;)&lt;br/&gt;• Employs optimal parameters found in Phase B/C&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_11"><mxGeometry x="822" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="comp_11_4" value="&lt;b&gt;&lt;font size='2' color='#a78bfa'&gt;💾 Pipeline Summary JSON&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align='left'&gt;&lt;font size='1' color='#e8e8f0'&gt;Consolidates all experimental outputs:&lt;br/&gt;• Serializes dataset statistics, baseline metrics, sweeps histories, ranked final results, and asset paths into a unified 1.4MB JSON file.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#252532;strokeColor=#2d2d3a;strokeWidth=1;fontColor=#e8e8f0;align=center;verticalAlign=top;spacingTop=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="lld_11"><mxGeometry x="1090" y="60" width="250" height="280" as="geometry" /></mxCell><mxCell id="flow_arrow_0" value="Stage 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c6af7;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_0" target="hld_1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_1" value="Stage 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a78bfa;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_1" target="hld_2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_2" value="Stage 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34d399;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_2" target="hld_3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_3" value="Stage 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fbbf24;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_3" target="hld_4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_4" value="Stage 6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#60a5fa;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_4" target="hld_5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_5" value="Stage 7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#fb923c;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_5" target="hld_6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_6" value="Stage 8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f87171;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_6" target="hld_7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_7" value="Stage 9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22d3ee;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_7" target="hld_8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_8" value="Stage 10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f472b6;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_8" target="hld_9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_9" value="Stage 11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818cf8;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_9" target="hld_10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_arrow_10" value="Stage 12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c6af7;strokeWidth=3.5;fillColor=none;endArrow=classic;" edge="1" parent="1" source="hld_10" target="hld_11"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>